{
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/favicon-(.*).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/android-chrome-(.*).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=86400" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/services/commercial-window-cleaning",
      "destination": "/services/residential-window-cleaning",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/reviews",
      "destination": "/api/leads?resource=website-reviews"
    },
    {
      "source": "/api/sms/inbound",
      "destination": "/api/leads?resource=sms-inbound"
    },
    {
      "source": "/api/our-work-gallery",
      "destination": "/api/projects?resource=our-work-gallery"
    },
    {
      "source": "/api/admin/our-work-gallery",
      "destination": "/api/admin/projects?resource=our-work-gallery"
    },

    {
      "source": "/((?!api/|sitemap\\.xml$|robots\\.txt$|assets/|favicon\\.ico$|favicon\\.svg$|favicon-|apple-touch-icon\\.png$|android-chrome-|site\\.webmanifest$).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/analytics-reports",
      "schedule": "0 15 * * *"
    }
  ]
}
