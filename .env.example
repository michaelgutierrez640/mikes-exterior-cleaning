# Public site config (optional — set in Vercel for NAP and Google Business Profile links in schema/footer)
VITE_BUSINESS_STREET_ADDRESS=
VITE_GOOGLE_REVIEWS_URL=

# Google Places API (server-side only — set in Vercel, never commit real values)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Admin dashboard (server-side only)
ADMIN_DASHBOARD_PASSWORD=

# Production Vercel Deploy Hook (server-side only — never use VITE_ prefix)
# Create in Vercel → Project → Settings → Git → Deploy Hooks (Production branch).
# Used after Completed Job publish / unpublish / delete so sitemap + prerender refresh.
# Set the same Production hook URL on Production and Preview server env if you test admin from Preview.
VERCEL_DEPLOY_HOOK_URL=

# Analytics + completed-job records + private CRM leads — Upstash Redis via Vercel Storage
# Vercel auto-injects these when Upstash Redis is connected to this project:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Also supported if present:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
STORAGE_REST_API_URL=
STORAGE_REST_API_TOKEN=

# Completed Jobs photo storage — Vercel Blob (server-side only; never expose to Vite/client)
# Connecting Blob in the Vercel project injects these automatically for Production + Preview:
BLOB_READ_WRITE_TOKEN=
# Also injected by Vercel Blob (unused by this app today; safe to leave set):
# BLOB_STORE_ID=
# BLOB_WEBHOOK_PUBLIC_KEY=

# CRM / Leads
# Leads reuse the same Upstash Redis + ADMIN_DASHBOARD_PASSWORD above.
# Public create: POST /api/leads (no PII in response)
#   Optional linkedLeadId on booking submits updates the Instant Quote lead in place.
# Admin read/update: GET/PATCH /api/leads (cookie auth required)
# Statuses: New | Contacted | Booked | Completed | Lost (legacy values mapped on read)
# Do not expose lead data via public projects, sitemap, or analytics APIs.

# SMS automations (Phase 2) — server-side only. Do NOT use VITE_ prefixes.
# Leave SMS_ENABLED unset/false until Twilio + A2P registration are ready.
# When disabled, leads still save and consent/automation fields are stored; no texts are sent.
SMS_ENABLED=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Mike's private owner-notification number (E.164, e.g. +12095551212). Never expose to the frontend.
SMS_OWNER_PHONE=
# Hours to wait after Completed before the Google review request SMS (default 24)
SMS_REVIEW_DELAY_HOURS=24
# Optional server override for the Google review link (falls back to VITE_GOOGLE_REVIEWS_URL)
GOOGLE_REVIEW_URL=
# Existing daily cron (/api/cron/analytics-reports) also runs SMS reminders + due review requests.
# Requires CRON_SECRET (same as analytics email reports).
# Twilio inbound webhook URL (STOP/START): https://www.mikesexteriorcleaning.com/api/sms/inbound

